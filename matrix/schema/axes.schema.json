{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "matrix/axes.yaml",
  "type": "object",
  "required": ["axes"],
  "additionalProperties": false,
  "properties": {
    "axes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "english", "description"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]$", "description": "축 글자. 축 이름 영어의 첫 글자"},
          "name": {"type": "string", "minLength": 1},
          "english": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "matrix/cells/<축>/index.mdx 머리말",
  "type": "object",
  "required": ["axis", "name", "english", "order"],
  "additionalProperties": false,
  "properties": {
    "axis": {"type": "string", "pattern": "^[A-Z]$", "description": "축 글자. 축 이름 영어의 첫 글자이고 폴더 이름과 같다"},
    "name": {"type": "string", "minLength": 1},
    "english": {"type": "string", "minLength": 1},
    "order": {"type": "integer", "minimum": 1, "description": "화면에 보이는 축 차례"}
  }
}

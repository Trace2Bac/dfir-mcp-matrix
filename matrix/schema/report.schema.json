{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reports/<서버>/<축>/<셀ID>.mdx 머리말",
  "type": "object",
  "required": ["cell", "details"],
  "additionalProperties": false,
  "properties": {
    "cell": {"type": "string", "pattern": "^[A-Z]\\d\\d$"},
    "details": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^([A-Z]\\d\\d\\.\\d\\d|not_implemented|not_applicable)$"},
          "exception": {"type": "boolean", "description": "true면 화면에 예외 표시가 붙고 본문에 **예외.**를 써야 한다"}
        }
      }
    }
  }
}

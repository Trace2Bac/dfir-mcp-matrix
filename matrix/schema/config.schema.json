{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "matrix/config.yaml",
  "type": "object",
  "required": ["version", "servers", "pilot_cells"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "매트릭스 정의 버전. 셀 정의를 바꾼 날짜(YYYY-MM-DD)"},
    "servers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "pilot_cells": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]\\d\\d$"}, "uniqueItems": true}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "matrix/config.yaml",
  "type": "object",
  "required": ["servers", "pilot_cells"],
  "additionalProperties": false,
  "properties": {
    "servers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "pilot_cells": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]\\d\\d$"}, "uniqueItems": true}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "matrix/cells/<ID>.yaml",
  "type": "object",
  "required": [
    "id",
    "name",
    "question",
    "conditional",
    "details"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]\\d\\d$",
      "description": "셀 번호. 첫 글자가 축 id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "묻는 일을 명사로"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "description": "셀이 묻는 질문 한 문장"
    },
    "conditional": {
      "type": "boolean",
      "description": "지원 기능이 있는 서버에만 보는 셀이면 true"
    },
    "applies_to": {
      "type": "string",
      "minLength": 1,
      "description": "조건부 셀의 적용 범위"
    },
    "boundary": {
      "type": "string",
      "description": "다른 셀과의 경계 설명"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "정의를 쓴 셀만. †를 판단하는 적용 범위"
    },
    "not_implemented": {
      "type": "string",
      "minLength": 1,
      "description": "정의를 쓴 셀만. 미구현의 뜻"
    },
    "not_applicable": {
      "type": "string",
      "minLength": 1,
      "description": "정의를 쓴 셀만. 비적용의 뜻"
    },
    "details": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]\\d\\d\\.\\d\\d$",
            "description": "상세 번호. 한 번 정하면 바꾸지 않는다. 새 상세는 쓰지 않은 다음 번호를 받는다"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "상세 이름. 언제든 바꿔도 된다(원고는 번호로 연결된다)"
          },
          "include": {
            "type": "string",
            "minLength": 1,
            "description": "포함 기준"
          },
          "exclude": {
            "type": "string",
            "minLength": 1,
            "description": "제외·범위 주의"
          },
          "seen_in": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "description": "원고는 아직 없지만 구현을 확인한 서버. 그 서버의 원고가 이 상세에 연결되면 지운다"
          }
        }
      }
    },
    "retired": {
      "type": "array",
      "description": "지운 상세. 번호를 다시 쓰지 않으려고 남긴다",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]\\d\\d\\.\\d\\d$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "merged_into": {
            "type": "string",
            "pattern": "^[A-Z]\\d\\d\\.\\d\\d$",
            "description": "다른 상세로 합쳤으면 그 번호"
          },
          "reason": {
            "type": "string",
            "description": "왜 지웠는지"
          }
        }
      }
    }
  },
  "dependentRequired": {
    "scope": [
      "not_implemented",
      "not_applicable"
    ]
  }
}

# problems-data 플러그인이 만든다(npm start·npm run build)
web/static/data/
# check가 잠깐 만드는 파일
*.lint.tmp
__pycache__/
.venv/
# 작업용 git worktree. 저장소 검색에 옛 사본이 걸리지 않게 한다
.claude/worktrees/
# tools/problems_build.py가 problems/_data/에서 만든다(배포 때 CI가 만든다). 장마다 따로 작업해도 충돌하지 않게 커밋하지 않는다
/problems/*
!/problems/_data/
/problems/_data/problems.json
